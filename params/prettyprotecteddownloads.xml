<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="fieldparams">
        <fieldset name="fieldparams">
            <field
                name="display_mode"
                type="list"
                label="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_DISPLAY_LABEL"
                default="buttons"
                validate="options"
            >
                <option value="buttons">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_DISPLAY_BUTTONS</option>
                <option value="cards">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_DISPLAY_CARDS</option>
                <option value="list">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_DISPLAY_LIST</option>
            </field>
            <field
                name="show_meta"
                type="radio"
                label="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_SHOW_META_LABEL"
                description="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_SHOW_META_DESC"
                layout="joomla.form.field.radio.switcher"
                default="1"
                filter="integer"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field
                name="card_class"
                type="text"
                label="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_CARD_CLASS_LABEL"
                description="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_CARD_CLASS_DESC"
                showon="display_mode:cards"
                filter="string"
            />
            <field
                name="heading_level"
                type="list"
                label="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_LABEL"
                description="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_DESC"
                default="h3"
                showon="display_mode:cards"
                validate="options"
            >
                <option value="h2">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_H2</option>
                <option value="h3">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_H3</option>
                <option value="h4">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_H4</option>
                <option value="h5">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_H5</option>
                <option value="h6">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_H6</option>
                <option value="p">PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_HEADING_LEVEL_NONE</option>
            </field>
            <field
                name="button_class"
                type="text"
                label="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_BUTTON_CLASS_LABEL"
                description="PLG_FIELDS_PRETTYPROTECTEDDOWNLOADS_PARAMS_BUTTON_CLASS_DESC"
                filter="string"
            />
        </fieldset>
    </fields>
</form>
